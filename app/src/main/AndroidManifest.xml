<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: the app is fully offline, which keeps the attack surface small. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_ticket"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnifiedTicket">

        <activity android:name=".ui.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.HomeActivity" android:exported="false" />
        <activity android:name=".ui.ServiceListActivity" android:exported="false" />
        <activity android:name=".ui.SeatSelectionActivity" android:exported="false" />
        <activity android:name=".ui.TicketActivity" android:exported="false" />
        <activity android:name=".ui.MyBookingsActivity" android:exported="false" />
    </application>
</manifest>
